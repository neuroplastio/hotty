      "s": "x"
     },
     "payload": "<p id=p>hi</p>",
     "reply": {
      "a": "ok",
      "re": "doc",
      "s": "x"
     }
    },
    {
     "send": {
      "a": "patch",
      "s": "x",
      "op": "text",
      "t": "p"
     },
     "payload": "bye",
     "reply": {
      "a": "ok",
      "re": "patch",
      "s": "x"
     }
    },
    {
     "inspect": [
      "x",
      "p"
     ],
     "expect": {
      "tag": "p",
      "text": "bye"
     }
    }
   ]
  },
