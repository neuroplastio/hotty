 "vectors": [
  {
   "name": "a=q answers ok and echoes n",
   "steps": [
    {
     "send": {
      "a": "q",
      "n": "7"
     },
     "reply": {
      "a": "ok",
      "re": "q",
      "n": "7"
     }
    }
   ]
  },
  {
   "name": "an unknown action is EINVAL",
   "steps": [
    {
     "send": {
      "a": "frob"
     },
     "reply": {
      "a": "err",
      "code": "EINVAL"
     }
    }
   ]
  },
  {
